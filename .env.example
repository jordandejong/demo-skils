# Copy to .env in this directory (gitignored). Used by appian-demo-capture
# so a phone session can record without an interactive login.
# Never commit .env. Never put these values in demos/, script.md, or the video.

LCP_URL=https://example.appiancloud.com
LCP_USERNAME=
LCP_PASSWORD=

# Optional aliases (same meaning):
# APPIAN_URL=
# APPIAN_USERNAME=
# APPIAN_PASSWORD=
